

# Copy this file to .env and fill in your real values

# Supabase configuration
SUPABASE_URL="https://your-project.supabase.co"
# Use the service_role key on the backend only; never expose it in the frontend.
SUPABASE_KEY="your-service-role-key"
# Optional only when the project contains a single user; otherwise set the target user UUID.
SUPABASE_USER_ID=""
# Needed to save transactions when that user has multiple wallets.
SUPABASE_WALLET_ID=""

# Langflow configuration
LANGFLOW_API_URL="https://your-langflow-instance.com/api/v1/run/<flow_id>"
LANGFLOW_API_KEY="your-langflow-api-key"

# Optional app settings
PORT="8000"
ENVIRONMENT="development"
